  "cards": [
    {
      "dot": "cyan",
      "title": "OCC Sin Bloqueos Pesados",
      "items": [
        "El cliente provee expected_parent_hash en cada llamada store_memory.",
        "Si otro worker escribió antes, la verificación en memoria aborta la mutación antes de corromper el árbol Merkle."
      ]
    },
    {
      "dot": "rose",
      "title": "Diff Unificado en Error",
      "items": [
        "La excepción *StaleRevisionError emite el hash de HEAD, la revisión actual y un diff unificado tripartito.",
        "El agente cliente puede realizar un merge semántico de tres vías en su contexto local y reintentar de forma autónoma."
      ]
    }
  ]
